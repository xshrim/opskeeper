# Container image names.
IMAGE_REPOSITORY=opskeeper
IMAGE_TAG=local

# PostgreSQL container and application database.
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
OPSK_DB_HOST=localhost:5432
OPSK_DB_NAME=opskeeper
OPSK_DB_USER=opskeeper
OPSK_DB_PASSWORD=opskeeper

# HTTP path prefix for pages, health checks, and APIs; use / for the root path.
OPSK_BASE_PATH=/opskeeper

# Runtime environment and Go service log format: raw, text, or json.
OPSK_ENVIRONMENT=development
OPSK_LOG_FORMAT=raw
OPSK_LOG_HEALTH_IGNORE=true

# API listen port; Compose publishes the same port on host and container.
OPSK_LISTEN_PORT=8080
OPSK_TRUSTED_PROXIES=
OPSK_ALLOWED_ORIGINS=
OPSK_HTTP_MAX_BODY_BYTES=2097152
OPSK_HTTP_RATE_LIMIT_PER_MINUTE=600

# Authentication and resource credential security.
OPSK_COOKIE_SECURE=false
OPSK_SESSION_ACCESS_TTL=15m
OPSK_SESSION_REFRESH_TTL=168h
OPSK_CREDENTIAL_KEY=

# Process shutdown, dependency retry, and Connector limits.
OPSK_SHUTDOWN_TIMEOUT=10s
OPSK_DEPENDENCY_TIMEOUT=2s
OPSK_CONNECTOR_TIMEOUT=10s
OPSK_CONNECTOR_MAX_CONCURRENCY=8
OPSK_CONNECTOR_MAX_RESPONSE_BYTES=4194304

# Diagnosis task coordination limits and inspection scheduling.
OPSK_DIAGNOSIS_COLLABORATION=2
OPSK_DIAGNOSIS_MAX_SUBAGENTS=24
OPSK_DIAGNOSIS_SUBAGENT_CONCURRENCY=4
OPSK_INSPECTION_SCHEDULE_INTERVAL=15s
OPSK_INSPECTION_WORKER_POLL_INTERVAL=2s
OPSK_INSPECTION_LEASE_DURATION=45s

# Notification queue configuration.
OPSK_MQ_BACKEND=postgres
OPSK_NOTIFICATION_QUEUE_POLL_INTERVAL=5s

# Cache: memory, postgres, or redis. Redis URL is needed only for redis cache
# and for integration tests that connect to Redis.
OPSK_CACHE_BACKEND=postgres
OPSK_REDIS_URL=

# Object storage shared configuration. Select local, postgres, or s3.
OPSK_STORAGE_BACKEND=postgres
# Local root applies only when OPSK_STORAGE_BACKEND=local.
OPSK_REPOSITORY_LOCAL_ROOT=/var/lib/opskeeper/repositories
OPSK_STORAGE_S3_PROVIDER=minio
OPSK_STORAGE_S3_ENDPOINT=
OPSK_STORAGE_S3_BUCKET=
OPSK_STORAGE_S3_PREFIX=repositories
OPSK_STORAGE_S3_ACCESS_KEY=
OPSK_STORAGE_S3_SECRET_KEY=
OPSK_STORAGE_S3_USE_SSL=false

# Repository-specific upload limit (bytes), default 512 MiB.
OPSK_REPOSITORY_MAX_BUNDLE_BYTES=536870912

# Monitoring and tracing. Empty OTLP endpoint disables export.
OPSK_OTEL_ENDPOINT=http://127.0.0.1:4318

# MCP security; enable HTTPS/public-address validation in production.
OPSK_MCP_ENHANCED_SECURITY=false

# Optional values for integration tests and `make sample-seed`.
OPSK_TEST_DATABASE_URL=
OPSK_TEST_KAFKA_BROKERS=
OPSK_TEST_DOCKER_HOST_URL=unix:///var/run/docker.sock
OPSK_TEST_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPSK_TEST_LLM_MODEL=GLM-4-Flash
OPSK_TEST_LLM_SCENARIO=general
OPSK_TEST_LLM_API_KEY=
OPSK_TEST_HOST_ADDRESS=
OPSK_TEST_HOST_PORT=22
OPSK_TEST_HOST_USERNAME=
OPSK_TEST_HOST_PASSWORD=
OPSK_TEST_HOST_AUTH_METHOD=password
OPSK_TEST_USER_PASWORD='Sample123!'
