# Optional GLM provider used by make sample-seed. Configure the API key in the UI if empty.
OPSK_TEST_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPSK_TEST_LLM_MODEL=GLM-4-Flash
OPSK_TEST_LLM_SCENARIO=general
OPSK_TEST_LLM_API_KEY=

# Direct Host resource used by make sample-seed. Configure its credential in the UI if empty.
OPSK_TEST_HOST_ADDRESS=173.254.197.151
OPSK_TEST_HOST_PORT=2002
OPSK_TEST_HOST_USERNAME=root
OPSK_TEST_HOST_PASSWORD=

# Direct Docker resource used by make sample-seed.
OPSK_TEST_DOCKER_HOST_URL=unix:///var/run/docker.sock

# Password for sample users.
OPSK_TEST_USER_PASWORD='Sample123!'
