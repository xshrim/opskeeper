# HTTP path prefix for pages, health checks, and APIs; use / for the root path.
OPSK_BASE_PATH=/opskeeper

# Runtime environment; use production for production deployments.
OPSK_ENVIRONMENT=development

# Go service log format; choose text or json.
OPSK_LOG_FORMAT=text

# Set the Secure flag on session cookies; must be true in production.
OPSK_COOKIE_SECURE=false

# Access token lifetime in Go duration syntax, for example 15m.
OPSK_SESSION_ACCESS_TTL=15m

# Refresh token lifetime in Go duration syntax; must exceed the access lifetime.
OPSK_SESSION_REFRESH_TTL=168h

# HTTP listen address, for example :8080 or 127.0.0.1:8080.
OPSK_HTTP_ADDRESS=:8080

# Trusted proxy IPs/CIDRs, comma-separated; empty means forwarded headers are ignored.
OPSK_TRUSTED_PROXIES=

# Allowed cross-origin HTTP(S) Origins, comma-separated; empty allows same-origin only.
OPSK_ALLOWED_ORIGINS=

# Maximum HTTP request body size in bytes; valid range is 1 KiB to 64 MiB.
OPSK_HTTP_MAX_BODY_BYTES=2097152

# Requests allowed per client IP per minute; valid range is 1 to 100000.
OPSK_HTTP_RATE_LIMIT_PER_MINUTE=600

# Resource credential encryption key; production requires a 32-byte or Base64 value.
OPSK_CREDENTIAL_KEY=

# Graceful shutdown timeout in Go duration syntax.
OPSK_SHUTDOWN_TIMEOUT=10s

# Dependency health-check timeout in Go duration syntax.
OPSK_DEPENDENCY_TIMEOUT=2s

# Total timeout for one Connector execution in Go duration syntax.
OPSK_CONNECTOR_TIMEOUT=10s

# Maximum concurrent Connector executions per process; valid range is 1 to 128.
OPSK_CONNECTOR_MAX_CONCURRENCY=8

# Maximum Connector response size in bytes; valid range is 1 KiB to 64 MiB.
OPSK_CONNECTOR_MAX_RESPONSE_BYTES=4194304

# Interval for scheduling inspection tasks in Go duration syntax.
OPSK_INSPECTION_SCHEDULE_INTERVAL=15s

# Worker polling interval for inspection tasks in Go duration syntax.
OPSK_INSPECTION_WORKER_POLL_INTERVAL=2s

# Inspection task lease duration in Go duration syntax.
OPSK_INSPECTION_LEASE_DURATION=45s

# Enable the controlled-operation submitter; keep disabled unless cluster access is configured.
OPSK_OPERATION_SUBMITTER_ENABLED=false

# Runner image used by the controlled-operation submitter.
OPSK_OPERATION_RUNNER_IMAGE=opskeeper:local

# PostgreSQL application database URL; inject a restricted account through a Secret in production.
OPSK_DATABASE_URL=postgres://opskeeper:opskeeper@localhost:5432/opskeeper?sslmode=disable

# Redis URL; inject production credentials through a Secret.
OPSK_REDIS_URL=redis://localhost:6379/0

# Bootstrap username; defaults to admin.
# OPSK_BOOTSTRAP_USERNAME=admin

# Optional bootstrap email; empty leaves the profile email unbound.
# OPSK_BOOTSTRAP_EMAIL=

# Optional bootstrap phone; empty leaves the profile phone unbound.
# OPSK_BOOTSTRAP_PHONE=

# Bootstrap display name; defaults to the bootstrap username.
# OPSK_BOOTSTRAP_DISPLAY_NAME=

# Restricted password file; empty generates a random password and prints it once.
# OPSK_BOOTSTRAP_PASSWORD_FILE=

# OTLP/HTTP Collector endpoint; empty disables OpenTelemetry export.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional external LLM Provider endpoint for make llm-provider-test.
OPSK_TEST_LLM_BASE_URL=https://api.siliconflow.cn/v1

# External LLM Provider model for make llm-provider-test.
OPSK_TEST_LLM_MODEL=deepseek-ai/DeepSeek-R1-0528-Qwen3-8B

# External LLM Provider API key; do not commit a real key.
OPSK_TEST_LLM_API_KEY=
